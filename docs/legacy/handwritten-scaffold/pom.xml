<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ruoyi</groupId>
    <artifactId>ruoyi</artifactId>
    <version>3.8.7</version>
    <packaging>pom</packaging>

    <name>ruoyi</name>
    <description>若依管理系统 - 上门服务记录与提成核算</description>

    <!--
        版本对齐说明：
        若依 RuoYi-Vue3 v3.8.7 官方后端为 Spring Boot 2.5.15 + Java 1.8，
        本 POM 与之保持一致，便于直接合并进若依脚手架。
        注意：Spring Boot 2.x 使用 javax.servlet，不是 jakarta.servlet。
    -->
    <properties>
        <ruoyi.version>3.8.7</ruoyi.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <spring-boot.version>2.5.15</spring-boot.version>
        <mybatis.version>3.5.16</mybatis.version>
        <druid.version>1.2.22</druid.version>
        <jwt.version>0.9.1</jwt.version>
        <fastjson2.version>2.0.49</fastjson2.version>
        <easyexcel.version>3.3.4</easyexcel.version>
    </properties>

    <!--
        模块说明：
        ruoyi-common / ruoyi-framework / ruoyi-system 由若依官方脚手架提供，
        本仓库只包含业务模块与启动模块。合并时把这三个目录从若依源码拷入即可，
        或保留官方父 POM、把本文件作为参考。

        当前仓库内的模块：
    -->
    <modules>
        <module>ruoyi-smtchs</module>
        <module>ruoyi-admin</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 若依内部模块 -->
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-common</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-framework</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-system</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-smtchs</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>

            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Excel 导出（双 Sheet 用 EasyExcel） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
