<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.smtchs.mapper.SmtWorkTypeMapper">

    <resultMap id="SmtWorkTypeResult" type="com.ruoyi.smtchs.domain.SmtWorkType">
        <id     property="id"          column="id"/>
        <result property="name"        column="name"/>
        <result property="billingMode" column="billing_mode"/>
        <result property="enabled"     column="enabled"/>
        <result property="sort"        column="sort"/>
        <result property="createBy"    column="create_by"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateBy"    column="update_by"/>
        <result property="updateTime"  column="update_time"/>
        <result property="delFlag"     column="del_flag"/>
    </resultMap>

    <sql id="selectWorkTypeVo">
        SELECT id, name, billing_mode, enabled, `sort`,
               create_by, create_time, update_by, update_time, del_flag
        FROM smt_work_type
    </sql>

    <select id="selectWorkTypeList" parameterType="com.ruoyi.smtchs.domain.SmtWorkType" resultMap="SmtWorkTypeResult">
        <include refid="selectWorkTypeVo"/>
        <where>
            del_flag = '0'
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="billingMode != null and billingMode != ''">
                AND billing_mode = #{billingMode}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY `sort` ASC, id ASC
    </select>

    <select id="selectWorkTypeById" parameterType="java.lang.Long" resultMap="SmtWorkTypeResult">
        <include refid="selectWorkTypeVo"/>
        WHERE id = #{id}
          AND del_flag = '0'
    </select>

    <select id="selectEnabledWorkTypes" resultMap="SmtWorkTypeResult">
        <include refid="selectWorkTypeVo"/>
        WHERE del_flag = '0'
          AND enabled = 1
        ORDER BY `sort` ASC, id ASC
    </select>

    <insert id="insertWorkType" parameterType="com.ruoyi.smtchs.domain.SmtWorkType"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO smt_work_type (
            name, billing_mode, enabled, `sort`, create_by, create_time, del_flag
        ) VALUES (
            #{name}, #{billingMode}, #{enabled}, #{sort}, #{createBy}, NOW(), '0'
        )
    </insert>

    <update id="updateWorkType" parameterType="com.ruoyi.smtchs.domain.SmtWorkType">
        UPDATE smt_work_type
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="billingMode != null and billingMode != ''">
                billing_mode = #{billingMode},
            </if>
            <if test="enabled != null">
                enabled = #{enabled},
            </if>
            <if test="sort != null">
                `sort` = #{sort},
            </if>
            <if test="updateBy != null">
                update_by = #{updateBy},
            </if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
          AND del_flag = '0'
    </update>

    <update id="deleteWorkTypeById" parameterType="java.lang.Long">
        UPDATE smt_work_type
        SET del_flag    = '2',
            update_time = NOW()
        WHERE id = #{id}
          AND del_flag = '0'
    </update>

</mapper>
