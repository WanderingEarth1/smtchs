<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.smtchs.mapper.SmtSysConfigMapper">

    <resultMap id="SmtSysConfigResult" type="com.ruoyi.smtchs.domain.SmtSysConfig">
        <id     property="id"                 column="id"/>
        <result property="overtimeStart"      column="overtime_start"/>
        <result property="overtimeMultiplier" column="overtime_multiplier"/>
        <result property="roundingRule"       column="rounding_rule"/>
        <result property="updateBy"           column="update_by"/>
        <result property="updateTime"         column="update_time"/>
    </resultMap>

    <sql id="selectConfigVo">
        SELECT id, overtime_start, overtime_multiplier, rounding_rule, update_by, update_time
        FROM smt_sys_config
    </sql>

    <!-- 全局唯一一行，取 id 最小的一条 -->
    <select id="selectConfig" resultMap="SmtSysConfigResult">
        <include refid="selectConfigVo"/>
        ORDER BY id ASC
        LIMIT 1
    </select>

    <select id="selectConfigById" parameterType="java.lang.Long" resultMap="SmtSysConfigResult">
        <include refid="selectConfigVo"/>
        WHERE id = #{id}
    </select>

    <insert id="insertConfig" parameterType="com.ruoyi.smtchs.domain.SmtSysConfig"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO smt_sys_config (
            overtime_start, overtime_multiplier, rounding_rule, update_by, update_time
        ) VALUES (
            #{overtimeStart}, #{overtimeMultiplier}, #{roundingRule}, #{updateBy}, NOW()
        )
    </insert>

    <update id="updateConfig" parameterType="com.ruoyi.smtchs.domain.SmtSysConfig">
        UPDATE smt_sys_config
        <set>
            <if test="overtimeStart != null and overtimeStart != ''">
                overtime_start = #{overtimeStart},
            </if>
            <if test="overtimeMultiplier != null">
                overtime_multiplier = #{overtimeMultiplier},
            </if>
            <if test="roundingRule != null and roundingRule != ''">
                rounding_rule = #{roundingRule},
            </if>
            <if test="updateBy != null">
                update_by = #{updateBy},
            </if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

</mapper>
