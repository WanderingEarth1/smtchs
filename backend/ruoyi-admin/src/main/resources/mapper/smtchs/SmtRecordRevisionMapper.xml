<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.smtchs.mapper.SmtRecordRevisionMapper">

    <resultMap id="SmtRecordRevisionResult" type="com.ruoyi.smtchs.domain.SmtRecordRevision">
        <id     property="id"           column="id"/>
        <result property="recordId"     column="record_id"/>
        <result property="operatorName" column="operator_name"/>
        <result property="revisedAt"    column="revised_at"/>
        <result property="beforeJson"   column="before_json"/>
        <result property="afterJson"    column="after_json"/>
        <result property="note"         column="note"/>
    </resultMap>

    <sql id="selectRevisionVo">
        SELECT id, record_id, operator_name, revised_at, before_json, after_json, note
        FROM smt_record_revision
    </sql>

    <!-- smt_record_revision 无 del_flag 列，逻辑删除由主记录控制 -->
    <select id="selectRevisionList" parameterType="com.ruoyi.smtchs.domain.SmtRecordRevision" resultMap="SmtRecordRevisionResult">
        <include refid="selectRevisionVo"/>
        <where>
            <if test="recordId != null">
                record_id = #{recordId}
            </if>
            <if test="operatorName != null and operatorName != ''">
                AND operator_name LIKE CONCAT('%', #{operatorName}, '%')
            </if>
        </where>
        ORDER BY revised_at DESC, id DESC
    </select>

    <select id="selectRevisionById" parameterType="java.lang.Long" resultMap="SmtRecordRevisionResult">
        <include refid="selectRevisionVo"/>
        WHERE id = #{id}
    </select>

    <select id="selectRevisionByRecordId" parameterType="java.lang.Long" resultMap="SmtRecordRevisionResult">
        <include refid="selectRevisionVo"/>
        WHERE record_id = #{recordId}
        ORDER BY revised_at DESC, id DESC
    </select>

    <insert id="insertRevision" parameterType="com.ruoyi.smtchs.domain.SmtRecordRevision"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO smt_record_revision (
            record_id, operator_name, revised_at, before_json, after_json, note
        ) VALUES (
            #{recordId}, #{operatorName}, IFNULL(#{revisedAt}, NOW()),
            #{beforeJson}, #{afterJson}, #{note}
        )
    </insert>

    <delete id="deleteRevisionById" parameterType="java.lang.Long">
        DELETE FROM smt_record_revision WHERE id = #{id}
    </delete>

    <delete id="deleteRevisionByRecordId" parameterType="java.lang.Long">
        DELETE FROM smt_record_revision WHERE record_id = #{recordId}
    </delete>

</mapper>
